# Environment for the pegRNA web app (read by the systemd --user unit).
# Copy to ~/.config/pegrna/pegrna.env on the deployment host and edit paths.
# NOTE: this file holds NO secrets. The NVIDIA key lives in NVIDIA_KEY_FILE below.

# Storage root + repo checkout (DSI: use /mnt/data2/mj1824).
PEGRNA_ROOT=/mnt/data2/mj1824/pegrna
PEGRNA_REPO=/mnt/data2/mj1824/pegrna/prime-editing

# Per-mode interpreters (from web/deploy/setup_envs.sh).
PEGRNA_WEB_PYTHON=/mnt/data2/mj1824/pegrna/envs/pegrna-web/bin/python
PEGRNA_API_PYTHON=/mnt/data2/mj1824/pegrna/envs/pegrna-real/bin/python

# PRIDICT2 pegRNA designer for api-mode auto-spacer design (built by setup_envs.sh).
# web/app.py injects these into the api-mode pipeline subprocess.
PRIDICT2_DIR=/mnt/data2/mj1824/pegrna/PRIDICT2
PRIDICT2_PYTHON=/mnt/data2/mj1824/pegrna/envs/pridict2/bin/python
# PRIDICT2 caps this at 3 itself ("Maximum 3 cores to prevent memory issues"),
# so asking for more buys nothing and risks the OOM it is guarding against.
PRIDICT2_CORES=3

# Per-run outputs (kept off the home quota; auto-pruned to PEGRNA_KEEP_RUNS).
PEGRNA_RUNS_DIR=/mnt/data2/mj1824/pegrna/runs
PEGRNA_KEEP_RUNS=200

# Loopback port (public exposure is via Tailscale Funnel, not this port).
PEGRNA_PORT=8092

# Boltz-2 NIM docking key (owner-only file, NOT committed). Without it, api mode
# runs every other gate for real and stubs docking.
NVIDIA_KEY_FILE=~/.config/pegrna/nvidia.key

# Abuse guards for a public site.
PEGRNA_MAX_CONCURRENCY=2
PEGRNA_TIMEOUT=1800
PEGRNA_MAX_CONFIG_BYTES=200000
PEGRNA_MAX_GENOME_LEN=50000

# Optional shared-secret gate. Empty = open to anyone. Set a value to require an
# `X-Access-Token` header (or ?token=) on the design endpoints.
PEGRNA_ACCESS_TOKEN=
