.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
.env
.ruff_cache/

# Pipeline run outputs (per-run design artifacts, reports, logs) — not source.
results/
*.log

# Web app per-run outputs (configs + reports written at request time).
web/runs/
# never commit the NVIDIA NIM key (it lives in ~/.config/pegrna/, not the repo)
nvidia.key
**/nvidia.key

# AlphaFold-DB structures fetched/cached at runtime — not source.
AF-*.cif

# Frontend toolchain. The BUILT assets in web/static/ ARE committed on purpose,
# so the deploy box serves the app without needing Node — only the toolchain and
# its caches are ignored.
node_modules/
web/frontend/node_modules/
web/frontend/.vite/
*.tsbuildinfo
